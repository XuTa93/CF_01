<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CF_01.ViewModels"
        xmlns:views="using:CF_01.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1027" d:DesignHeight="768"
        x:Class="CF_01.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CF_01">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <views:Fire x:Name="FireControl" Grid.Column="0"/>

      <!-- Hourly averages Panel -->
      <Border Grid.Column="1"
              Width="160"
              Margin="0,3,3,3"
              Padding="5"
              CornerRadius="12"
              Background="#22888888"
              BorderBrush="#44AAAAAA"
              BorderThickness="1"
              DataContext="{Binding #FireControl.DataContext}"
              x:DataType="vm:FireViewModel">

        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="{Binding IntervalPanelTitle}"
                     FontSize="12" FontWeight="Bold" Foreground="#4CAF50"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,6"/>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding IntervalAverages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IntervalAverageEntry">
                  <Border Padding="4,3" Margin="0,1"
                          Background="#10FFFFFF" CornerRadius="4">
                    <StackPanel Spacing="2">
                      <!-- Dòng 1: Thời gian bắt đầu → kết thúc -->
                      <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StartTimeText}"
                                   FontSize="10" FontWeight="Bold" Foreground="#4CAF50"
                                   FontFamily="Consolas"/>
                        <TextBlock Text="→" FontSize="10" Foreground="#888888"/>
                        <TextBlock Text="{Binding EndTimeText}"
                                   FontSize="10" FontWeight="Bold" Foreground="#4CAF50"
                                   FontFamily="Consolas"/>
                      </StackPanel>
                      <!-- Dòng 2: TB, Min, Max -->
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Average, StringFormat='TB:{0:F1}°'}"
                                   FontWeight="Bold" FontSize="11"
                                   Foreground="#FFCC44"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Min, StringFormat='↓{0:F0}'}"
                                   FontSize="10" Foreground="#66AAFF"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Max, StringFormat='↑{0:F0}'}"
                                   FontSize="10" Foreground="#FF6644"
                                   VerticalAlignment="Center"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
</Window>
