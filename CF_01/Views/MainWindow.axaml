<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CF_01.ViewModels"
        xmlns:views="using:CF_01.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="550"
        x:Class="CF_01.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CF_01">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <views:Fire x:Name="FireControl" Grid.Column="0"/>

      <!-- Per-minute averages Panel -->
      <Border Grid.Column="1"
              Width="160"
              Margin="0,3,3,3"
              Padding="5"
              CornerRadius="12"
              Background="#22888888"
              BorderBrush="#44AAAAAA"
              BorderThickness="1"
              DataContext="{Binding #FireControl.DataContext}"
              x:DataType="vm:FireViewModel">

        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="📈 TB THEO PHÚT"
                     FontSize="12" FontWeight="Bold" Foreground="#4CAF50"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,6"/>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MinuteAverages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MinuteAverageEntry">
                  <Border Padding="3,2" Margin="0,1"
                          Background="#10FFFFFF" CornerRadius="3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Grid.Column="0"
                              Background="#334CAF50"
                              CornerRadius="3"
                              Padding="4,1"
                              Margin="0,0,4,0"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding TimeLabel}"
                                   FontSize="10" FontWeight="Bold" Foreground="#4CAF50"
                                   FontFamily="Consolas"/>
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Average, StringFormat='{}{0:F1}°'}"
                                 FontWeight="Bold" FontSize="11"
                                 Foreground="#FFCC44"
                                 VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Min, StringFormat='↓{0:F0}'}"
                                   FontSize="10" Foreground="#66AAFF"/>
                        <TextBlock Text="{Binding Max, StringFormat='↑{0:F0}'}"
                                   FontSize="10" Foreground="#FF6644"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
</Window>
